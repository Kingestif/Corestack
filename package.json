{
    "name": "Corestack",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "scripts": {
        "dev": "nodemon --exec tsx ./src/server.ts",
        "build": "tsc",
        "start": "node ./dist/server.js",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.15.1",
            "onFail": "download"
        }
    },
    "type": "module",
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "express": "^5.2.1",
        "morgan": "^1.11.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/morgan": "^1.9.10",
        "@types/node": "^26.1.1",
        "dotenv": "^17.4.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "nodemon": "^3.1.14",
        "prettier": "3.9.6",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
}
